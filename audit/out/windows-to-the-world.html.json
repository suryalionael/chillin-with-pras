    {
      "type": "p",
      "text": "Draw the blinds",
      "style": ""
    },
    {
      "type": "p",
      "text": "And reveal yourselves",
      "style": ""
    },
    {
      "type": "p",
      "text": "Of the lives and the secrets",
      "style": ""
    },
    {
      "type": "p",
      "text": "That you preciously guard.",
      "style": ""
    },
    {
      "type": "p",
      "text": "Raise the curtains",
      "style": ""
    },
    {
      "type": "p",
      "text": "To exhibit your fruits",
      "style": ""
    },
    {
      "type": "p",
      "text": "Of crime and corruption",
      "style": ""
    },
    {
      "type": "p",
      "text": "That you heavily stash.",
      "style": ""
    },
    {
      "type": "p",
      "text": "Open the louvres",
      "style": ""
    },
    {
      "type": "p",
      "text": "And expose your truth",
      "style": ""
    },
    {
      "type": "p",
      "text": "Of love-making and rape",
      "style": ""
    },
    {
      "type": "p",
      "text": "That give rise to abuse.",
      "style": ""
    },
    {
      "type": "p",
      "text": "Unhinge the panes",
      "style": ""
    },
    {
      "type": "p",
      "text": "To release the stigma",
      "style": ""
    },
    {
      "type": "p",
      "text": "Of indulgence and contempt",
      "style": ""
    },
    {
      "type": "p",
      "text": "That measures success.",
      "style": ""
    },
    {
      "type": "p",
      "text": "Yet beyond the walls",
      "style": ""
    },
    {
      "type": "p",
      "text": "We are no less disgraced",
      "style": ""
    },
    {
      "type": "p",
      "text": "Of predation and perversion",
      "style": ""
    },
    {
      "type": "p",
      "text": "That pollute our minds.",
      "style": ""
    }
  ]
