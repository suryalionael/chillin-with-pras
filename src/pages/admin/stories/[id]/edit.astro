---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getEnv } from '../../../../lib/cms/runtime.ts';
import { getStory, type D1Like, type Story } from '../../../../lib/cms/db.ts';
import { isUuid } from '../../../../lib/cms/api.ts';

export const prerender = false;

const id = Astro.params.id;
let story: Story | null = null;
let loadError = false;
if (isUuid(id)) {
  try {
    story = await getStory((await getEnv()).DB as unknown as D1Like, id);
  } catch (e) {
    console.error('admin edit: could not load story', e instanceof Error ? e.message : e);
    loadError = true;
  }
}
if (!story) Astro.response.status = loadError ? 500 : 404;
---

<AdminLayout title={story?.draft.title || 'Untitled story'}>
  {
    !story ? (
      <>
        <p class="admin-kicker"><a href="/admin/">← All stories</a></p>
        <h1 class="ed-missing">{loadError ? 'This story could not be loaded.' : 'Story not found.'}</h1>
      </>
    ) : (
      <div data-story-id={story.id} data-draft-rev={story.draftRev}>
        <editor-wrapper
          client:only="react"
          story-id={story.id}
          initial-doc={JSON.stringify(story.draft)}
          initial-rev={story.draftRev}
        />
      </div>
    )
  }
</AdminLayout>

<style>
  .ed-missing {
    margin-top: 1rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 2.6rem;
  }
</style>