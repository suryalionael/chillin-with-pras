---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getEnv } from '../../../../lib/cms/runtime.ts';
import { getStory, type D1Like, type Story } from '../../../../lib/cms/db.ts';
import { isUuid } from '../../../../lib/cms/api.ts';

export const prerender = false;

const id = Astro.params.id;
let story: Story | null = null;
if (isUuid(id)) {
  try {
    story = await getStory((await getEnv()).DB as unknown as D1Like, id);
  } catch (e) {
    console.error('admin preview: could not load story', e instanceof Error ? e.message : e);
  }
}
if (!story) Astro.response.status = 404;

const kinds = new Map<string, number>();
for (const b of story?.draft.body.content ?? []) kinds.set(b.type, (kinds.get(b.type) ?? 0) + 1);
---

<AdminLayout title="Preview">
  {
    !story ? (
      <>
        <p class="admin-kicker"><a href="/admin/">← All stories</a></p>
        <h1 class="pv-title">Story not found.</h1>
      </>
    ) : (
      <>
        <p class="admin-kicker"><a href={`/admin/stories/${story.id}/edit/`}>← Back to editing</a></p>
        <h1 class="pv-title">{story.draft.title || 'Untitled story'}</h1>
        {story.draft.subtitle && <p class="pv-sub">{story.draft.subtitle}</p>}

        <p class="admin-notice">
          <strong>Preview shell.</strong> The finished preview will render this draft with the public site’s own article
          templates. That needs the public renderer to accept CMS stories, which is a later phase.
        </p>

        <h2 class="pv-h">What the draft contains</h2>
        {
          kinds.size === 0 ? (
            <p class="pv-empty">Nothing written yet.</p>
          ) : (
            <ul class="pv-kinds">
              {[...kinds].map(([kind, n]) => <li><span>{kind}</span><span>{n}</span></li>)}
            </ul>
          )
        }
      </>
    )
  }
</AdminLayout>

<style>
  .pv-title {
    margin-top: 1rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .pv-sub {
    margin-top: 0.75rem;
    font-size: 1.6rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  .pv-h {
    margin-top: 2.5rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.9rem;
  }
  .pv-empty {
    margin-top: 0.75rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  .pv-kinds {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    max-width: 24rem;
    font-family: var(--sans);
  }
  .pv-kinds li {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
</style>
