---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { PreviewWrapper } from '../../../../components/editor/PreviewWrapper.tsx';
import { getEnv } from '../../../../lib/cms/runtime.ts';
import { getStory, type D1Like, type Story } from '../../../../lib/cms/db.ts';
import { isUuid } from '../../../../lib/cms/api.ts';

export const prerender = false;

const id = Astro.params.id;
let story: Story | null = null;
if (isUuid(id)) {
  try {
    story = await getStory((await getEnv()).DB as unknown as D1Like, id);
  } catch (e) {
    console.error('admin preview: could not load story', e instanceof Error ? e.message : e);
  }
}
if (!story) Astro.response.status = 404;
---

<AdminLayout title="Preview">
  {
    !story ? (
      <>
        <p class="admin-kicker"><a href="/admin/">← All stories</a></p>
        <h1 class="pv-title">Story not found.</h1>
      </>
    ) : (
      <div data-story-id={story.id} data-draft-rev={story.draftRev}>
        <PreviewWrapper
          client:only="react"
          storyId={story.id}
          initialDoc={JSON.stringify(story.draft)}
        />
      </div>
    )
  }
</AdminLayout>

<style>
  .pv-title {
    margin-top: 1rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
</style>