---
import ArticlePage from '../../components/ArticlePage.astro';
import { getArticlesInSection } from '../../lib/cms/build-content.ts';

export async function getStaticPaths() {
  const articles = await getArticlesInSection('show');
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
---

<ArticlePage slug={slug} section="show" />