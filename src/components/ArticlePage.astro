---
import Base from '../layouts/Base.astro';
import ArticleHeader from './ArticleHeader.astro';
import ArticleBody from './ArticleBody.astro';
import ArticleNav from './ArticleNav.astro';
import Figure from './Figure.astro';
import { getArticleBySlug, getArticlesInSection } from '../lib/cms/build-content.ts';
import { leadImage, sectionCover } from '../lib/site.mjs';
import { findImage } from '../lib/images';

const { slug, section } = Astro.props;
const article = await getArticleBySlug(slug!);
if (!article || article.section !== section) {
  throw new Error(`Unknown article ${section}/${slug}`);
}

// prev/next must consider legacy + CMS articles in the combined list
const siblings = await getArticlesInSection(section);
const idx = siblings.findIndex((a) => a.slug === article.slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

const introIdx = article.blocks.findIndex(
  (b) => b.type === 'p' && !b.subhead && b.text !== article.dateline
);
const intro = introIdx >= 0 ? article.blocks[introIdx] : null;
let bodyBlocks = introIdx >= 0 ? article.blocks.filter((_, i) => i !== introIdx) : article.blocks;

// Reading journey: title, metadata, then a large photograph. The entry's first
// photograph becomes the hero when it appears near the top of the story; a
// photograph the author placed much deeper stays where it was written.
const firstImg = bodyBlocks.findIndex((b) => b.type === 'img');
const hero = firstImg >= 0 && firstImg <= 8 ? bodyBlocks[firstImg] : null;
if (hero) bodyBlocks = bodyBlocks.filter((_, i) => i !== firstImg);
const canonicalUrl = `https://www.chillinwithpras.com${article.path}`;

// og:image: legacy images resolve through the asset pipeline; CMS images use
// the public /images/{id} route; fall back to the section cover / site og.
let og = 'https://www.chillinwithpras.com/og.jpg';
const ogLead = article.blocks.find((b) => b.type === 'img');
if (ogLead && ogLead.source === 'cms') {
  og = `https://www.chillinwithpras.com/images/${ogLead.imageId}`;
} else {
  try {
    const file = ogLead && !ogLead.source ? ogLead.file : leadImage(article);
    og = `https://www.chillinwithpras.com${findImage(file).src}`;
  } catch {
    try {
      og = `https://www.chillinwithpras.com${findImage(sectionCover(section)).src}`;
    } catch {
      /* keep default */
    }
  }
}
---

<Base
  title={article.title}
  description={(intro?.text ?? '').slice(0, 150)}
  canonical={canonicalUrl}
  ogImage={og}
  current={article.path}
  type="article"
>
  <article class="container story">
    <ArticleHeader
      section={section}
      entry={article.order}
      title={article.title}
      intro={intro?.text ?? ''}
      dateline={article.dateline}
    />

    {hero && (
      <div class="story__hero">
        {!hero.source || hero.source === 'legacy' ? (
          <Figure variant="single" files={[{ file: hero.file, alt: hero.alt || article.title }]} hero={true} />
        ) : (
          <Figure variant="single" files={[{ imageId: hero.imageId, alt: hero.alt || article.title, caption: hero.caption, decorative: hero.decorative, size: hero.size }]} hero={true} isCms={true} />
        )}
      </div>
    )}

    <ArticleBody blocks={bodyBlocks} dateline={article.dateline} />
  </article>

  <ArticleNav article={article} section={section} prev={prev} next={next} />
</Base>

<style>
  .story__hero {
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
</style>