---
// Renders inline content with bold/italic/link formatting from CMS
const { inline } = Astro.props;
---

{inline.map((node, i) => {
  if (node.br) return <br key={i} />;
  const style = {};
  // 600, not 700: against a serif body this weight already reads as clear
  // emphasis without the heavier, more "UI" look a full bold jump gives.
  if (node.bold) style.fontWeight = 600;
  if (node.italic) style.fontStyle = 'italic';
  if (node.href) {
    return (
      <a key={i} href={node.href} target="_blank" rel="noopener noreferrer" style={style}>
        {node.text}
      </a>
    );
  }
  return <span key={i} style={style}>{node.text}</span>;
})}