---
import { renderSequence } from '../lib/render.mjs';
import { parseEmbedUrl } from '../lib/content/embed-url.ts';
import Figure from './Figure.astro';
import InlineContent from './InlineContent.astro';
import ProseList from './ProseList.astro';

const { blocks, dateline = '' } = Astro.props;
const seq = renderSequence(blocks, dateline);

// Rhythm for single photographs: full-width, then inset right, full-width,
// then inset left — so a long article never repeats the same shape twice.
const tones = ['wide', 'inset-right', 'wide', 'inset-left'];
let singles = 0;
---

<div class="prose">
  {
    seq.map((item) => {
      if (item.type === 'paragraph') {
        if (item.dateline) {
          return (
            <p class="prose__text dateline hand-date" aria-label="Dateline">
              {item.text}
            </p>
          );
        }
        if (item.subhead) {
          if (item.inline) {
            return <h2 class="prose__text subhead"><InlineContent inline={item.inline} /></h2>;
          }
          return <h2 class="prose__text subhead">{item.text}</h2>;
        }
        if (item.inline) {
          return <p class="prose__text prose__p"><InlineContent inline={item.inline} /></p>;
        }
        return <p class="prose__text prose__p">{item.text}</p>;
      }

      if (item.type === 'subheading') {
        return <h3 class="prose__text prose__subheading">{item.inline ? <InlineContent inline={item.inline} /> : item.text}</h3>;
      }

      if (item.type === 'quote') {
        return (
          <blockquote class="prose__text prose__quote">
            {item.paragraphs.map((p, i) => (
              <p key={i}><InlineContent inline={p} /></p>
            ))}
          </blockquote>
        );
      }

      if (item.type === 'list') {
        return <ProseList items={item.items} ordered={item.ordered} />;
      }

      if (item.type === 'divider') {
        return <hr class="prose__text prose__divider" />;
      }

      if (item.type === 'embed') {
        if (!item.url) return null;
        const parsed = parseEmbedUrl(item.url);
        if (parsed) {
          return (
            <div class="prose__text prose__embed prose__embed--live">
              <iframe
                src={parsed.embedSrc}
                title="Embedded content"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
          );
        }
        return (
          <a class="prose__text prose__embed prose__embed--link" href={item.url} target="_blank" rel="noopener noreferrer">
            {item.url}
          </a>
        );
      }

      // figure
      const tone = item.variant === 'single' ? tones[singles++ % tones.length] : 'wide';
      return (
        <div class="prose__figure">
          <Figure variant={item.variant} files={item.files} tone={tone} isCms={item.isCms} />
        </div>
      );
    })
  }
</div>

<style>
  .prose {
    width: 100%;
    padding-top: 0.5rem;
  }

  /* text keeps a comfortable measure; photographs use the full width */
  .prose__text {
    max-width: var(--read);
    margin-left: auto;
    margin-right: auto;
  }

  .prose__p {
    font-family: var(--serif);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.85;
    margin-bottom: 1.5em;
    color: var(--ink);
  }

  .prose__figure {
    margin: 4.5rem 0 5rem;
  }

  .subhead {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.25;
    margin-top: 4.5rem;
    margin-bottom: 1.75rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .subhead::before {
    content: '';
    flex: none;
    width: 3rem;
    height: 1px;
    background: var(--accent-warm);
    transform: translateY(-0.25em);
  }

  /* the prose column margin above a subhead that follows a photograph */
  .prose__figure + .subhead {
    margin-top: 0;
  }

  .prose__subheading {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.25;
    margin-top: 2rem;
    margin-bottom: 1.75rem;
    color: var(--ink);
  }

  .prose__quote {
    margin: 2rem auto;
    padding-left: 1.5rem;
    border-left: 3px solid var(--accent-warm);
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
  }
  .prose__quote p {
    margin: 0 0 0.75em;
    font-size: var(--fs-body);
    line-height: 1.75;
  }
  .prose__quote p:last-child {
    margin-bottom: 0;
  }

  .prose__divider {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem auto;
    width: 100%;
  }

  .prose__embed--live {
    margin: 2.5rem auto;
    max-width: 44rem;
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    background: #000;
    border-radius: 2px;
    overflow: hidden;
  }

  .prose__embed--live iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .prose__embed--link {
    display: block;
    margin: 2rem auto;
    padding: 1.25rem 1.5rem;
    max-width: 42rem;
    background: var(--paper-deep, rgba(0, 0, 0, 0.03));
    border: 1px solid var(--line-strong, var(--line));
    border-radius: 2px;
    font-family: var(--sans, system-ui, sans-serif);
    color: var(--accent-warm);
    font-size: 1.05rem;
    text-decoration: none;
    word-break: break-word;
  }

  .prose__embed--link:hover {
    text-decoration: underline;
  }

  .dateline {
    font-size: calc(var(--fs-hand) * 1.2);
    text-align: right;
    margin-top: 4rem;
    line-height: 1.3;
  }

  @media (max-width: 800px) {
    .prose__p {
      font-size: 1.28rem;
      line-height: 1.8;
    }

    .subhead {
      font-size: 1.7rem;
      margin-top: 3.5rem;
    }

    .prose__subheading {
      font-size: 1.7rem;
    }

    .prose__figure {
      margin: 3rem 0 3.5rem;
    }
  }
</style>
